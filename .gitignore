# 환경변수 / 시크릿
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# 로그
*.log

# 데이터 (용량 크고 API로 재생성 가능 — git에 올리지 않음)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# 알약 사진 캐시 / OCR 결과 캐시 (식약처에서 다시 받으면 되고, OCR 은 다시 읽으면 됨)
data/pill_cache/
data/ocr_cache.json

# 상담/자판기 연동 로컬 DB (SQLite)
data/*.db

# 노트북 체크포인트
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
