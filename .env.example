# 식약처 e약은요 공공데이터 API 인증키 (data.go.kr에서 발급)
EYAK_SERVICE_KEY=

# 아래는 이후 STEP 3~6에서 필요 (지금은 비워둬도 됨)
OPENAI_API_KEY=
PINECONE_API_KEY=

# 화상 상담용 Daily.co (dashboard.daily.co > Developers > API keys)
DAILY_API_KEY=

# 32자 이상 무작위 비밀값. 프론트엔드에 전달하지 않는다.
# 설정하면 기존 /consultations API에도 Bearer 인증이 적용된다.
CONSULT_AUTH_SECRET=
CONSULT_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
CONSULT_SUMMARY_MODEL=gpt-4o

# Supabase Connect의 Session pooler URL. 비밀번호 특수문자는 URL 인코딩한다.
# 비어 있으면 일반 서버는 로컬 SQLite를 사용한다. 시연 서버는 별도 로컬 DB만 사용한다.
DATABASE_URL=
