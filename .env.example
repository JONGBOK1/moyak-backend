# 식약처 e약은요 공공데이터 API 인증키 (data.go.kr에서 발급)
EYAK_SERVICE_KEY=

# 아래는 이후 STEP 3~6에서 필요 (지금은 비워둬도 됨)
OPENAI_API_KEY=
PINECONE_API_KEY=

# 화상 상담용 Daily.co (dashboard.daily.co > Developers > API keys)
DAILY_API_KEY=

# 지도 API (/api/v1/map). 팀 Supabase(PostGIS) Session pooler 연결 문자열 — 비우면 이 서버 DB의 시연용 가상 자판기를 사용
MAP_DATABASE_URL=
# 지도 화면 기본 중심 "위도,경도" (위치 권한 없을 때). 비우면 동양미래대학교
DEMO_MAP_CENTER=
# 카카오 지도 JavaScript 키 (developers.kakao.com, 플랫폼 > Web에 localhost:8000, moyak-backend.onrender.com 등록)
KAKAO_JS_KEY=
# 챗봇 보강: Supabase의 식약처 허가정보·DUR(병용금기/임부금기/노인주의 등)을 답변 근거에 추가 (1=켜기, 비우면 꺼짐)
# 연결은 DRUG_DATABASE_URL → 없으면 MAP_DATABASE_URL 사용. 조회 실패 시 기존 챗봇과 동일하게 동작
DRUG_DB_ENRICH=
DRUG_DATABASE_URL=
# 상담 음성 전사·요약 모델 (비우면 기본값: gpt-4o-mini-transcribe / gpt-4o)
CONSULT_TRANSCRIPTION_MODEL=
CONSULT_SUMMARY_MODEL=
# (선택) 상담 Bearer 토큰 서명용 32자 이상 비밀값. 비우면 X-Moyak-User-Id/X-Moyak-Role 헤더 방식만 사용
CONSULT_AUTH_SECRET=
# 알약 사진 인식 (/pills/identify). 각인 읽기용 Google Cloud Vision API 키 — 비우면 모양·색만으로 후보를 낸다
GOOGLE_VISION_API_KEY=
# 알약 검색용 Supabase(읽기 전용). 비우면 DRUG_DATABASE_URL → MAP_DATABASE_URL 순으로 사용
PILL_DATABASE_URL=
