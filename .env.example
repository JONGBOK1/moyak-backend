# 식약처 e약은요 공공데이터 API 인증키 (data.go.kr에서 발급)
EYAK_SERVICE_KEY=

# 아래는 이후 STEP 3~6에서 필요 (지금은 비워둬도 됨)
OPENAI_API_KEY=
PINECONE_API_KEY=

# 화상 상담용 Daily.co (dashboard.daily.co > Developers > API keys)
DAILY_API_KEY=

# 지도 API (/api/v1/map). 팀 Supabase(PostGIS) Session pooler 연결 문자열 — 비우면 이 서버 DB의 시연용 가상 자판기를 사용
MAP_DATABASE_URL=
# 지도 화면 기본 중심 "위도,경도" (위치 권한 없을 때). 비우면 동양미래대학교
DEMO_MAP_CENTER=
# 카카오 지도 JavaScript 키 (developers.kakao.com, 플랫폼 > Web에 localhost:8000, moyak-backend.onrender.com 등록)
KAKAO_JS_KEY=
